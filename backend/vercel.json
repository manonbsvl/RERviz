{
  "version": 2,
  "buildCommand": "node scripts/prepare-data.js",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/gtfs/**",
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
